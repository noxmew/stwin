<Window x:Class="STWin.Views.ConfirmDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI" FontSize="13">
  <Grid><Border Margin="16" CornerRadius="18" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.15"/></Border.Effect>
    <Grid Margin="28">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border x:Name="Badge" Width="40" Height="40" Background="#EEF2FF" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,20">
        <TextBlock x:Name="BadgeIcon" Text="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#4F46E5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
      </Border>
      <TextBlock x:Name="Heading" Grid.Row="1" FontSize="21" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap"/>
      <TextBlock x:Name="Description" Grid.Row="2" Foreground="#64748B" TextWrapping="Wrap" LineHeight="23" Margin="0,12,0,28"/>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelAction" Content="取消" IsCancel="True" Background="#F1F5F9" MinWidth="86" Margin="0,0,10,0"/>
        <Button x:Name="ConfirmAction" Background="#4F46E5" Foreground="White" MinWidth="100" Click="ConfirmClick"/>
      </StackPanel>
    </Grid>
  </Border></Grid>
</Window>
