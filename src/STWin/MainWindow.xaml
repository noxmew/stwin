<Window x:Class="STWin.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="STWin" Icon="Assets/stwin.ico" Width="1180" Height="760" MinWidth="760" MinHeight="520" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" Background="#F8FAFC" FontFamily="Microsoft YaHei UI" FontSize="13" Closing="OnClosing">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="42"/><Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" CornerRadius="6">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E2E8F0"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#CBD5E1"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Foreground" Value="#BE4352"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#BE4352"/><Setter Property="Foreground" Value="White"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#9F3546"/><Setter Property="Foreground" Value="White"/></Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Background="#F8FAFC">
    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="12,0,4,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="22" Height="22" Background="#4F46E5" CornerRadius="6" Margin="0,0,8,0">
          <Grid Margin="4"><Rectangle Width="9" Height="7" Stroke="#A5B4FC" StrokeThickness="1.2" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left" VerticalAlignment="Top"/>
          <Rectangle Width="12" Height="10" Stroke="White" StrokeThickness="1.4" Fill="#4F46E5" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
        </Border>
        <TextBlock Text="STWin" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="FullscreenButton" Style="{StaticResource CaptionButton}" Content="&#xE740;" ToolTip="全屏" AutomationProperties.Name="全屏" Click="FullscreenClick" Visibility="Collapsed"/>
        <Button x:Name="MoreButton" Style="{StaticResource CaptionButton}" Content="&#xE712;" ToolTip="设置与更多" AutomationProperties.Name="设置与更多" Click="MoreClick">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem x:Name="PinBox" Header="窗口置顶" IsCheckable="True" Click="PinClick"/>
              <MenuItem x:Name="SizingBox" Header="自适应缩放" IsCheckable="True" Click="SizingClick"/>
              <Separator/>
              <MenuItem x:Name="MuteBox" Header="静音" IsCheckable="True" Click="PreferencesClick" ToolTip="下次连接时生效"/>
              <MenuItem x:Name="KeysBox" Header="系统组合键发送到分身" IsCheckable="True" Click="PreferencesClick" ToolTip="下次连接时生效"/>
              <Separator/>
              <MenuItem x:Name="AdminSetupButton" Header="启用管理员支持" Click="AdminEnableClick"/>
              <MenuItem x:Name="AdminStatusItem" Header="管理员支持已启用" IsEnabled="False" Visibility="Collapsed"/>
              <MenuItem x:Name="AdminRemoveButton" Header="移除管理员支持" Click="AdminRemoveClick" Visibility="Collapsed"/>
              <Separator/>
              <MenuItem Header="复制诊断信息" Click="DiagnosticsClick"/>
              <MenuItem x:Name="StopButton" Header="结束桌面分身" Foreground="#BE4352" Click="StopClick" IsEnabled="False"/>
              <Separator/>
              <MenuItem Header="退出 STWin" Click="ExitClick"/>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <Border Width="1" Height="14" Background="#E2E8F0" Margin="5,0"/>
        <Button Style="{StaticResource CaptionButton}" ToolTip="最小化" AutomationProperties.Name="最小化" Click="MinimizeClick">
          <Path Width="12" Height="12" Data="M1,6 H11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
        </Button>
        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" ToolTip="最大化" AutomationProperties.Name="最大化" Click="MaximizeClick">
          <Grid Width="12" Height="12">
            <Path x:Name="MaximizeGlyph" Data="M1,1 H11 V11 H1 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
            <Path x:Name="RestoreGlyph" Data="M1,3 H9 V11 H1 Z M3,3 V1 H11 V9 H9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Visibility="Collapsed"/>
          </Grid>
        </Button>
        <Button Style="{StaticResource CloseCaptionButton}" ToolTip="关闭" AutomationProperties.Name="关闭" Click="ExitClick">
          <Path Width="12" Height="12" Data="M1,1 L11,11 M1,11 L11,1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
        </Button>
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1">
    <Border x:Name="UpdateBanner" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="20,0,20,12" Visibility="Collapsed">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="UpdateText" TextWrapping="Wrap" Foreground="#4338CA" Margin="0,0,12,0" VerticalAlignment="Center"/>
        <Button x:Name="UpdateAction" Grid.Column="1" Content="更新" Background="#4F46E5" Foreground="White" Padding="16,8" Click="UpdateClick"/>
        <Button x:Name="UpdateLater" Grid.Column="2" Content="稍后" Padding="12,8" Margin="8,0,0,0" Click="DismissUpdateClick"/>
      </Grid>
    </Border>
    <Border x:Name="ErrorBanner" Background="#FFF1F2" BorderBrush="#FFE4E6" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="20,0,20,12" Visibility="Collapsed">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="暂时无法完成操作" Foreground="#9F3546" FontWeight="SemiBold"/><TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#9F5662" Margin="0,5,12,0"/></StackPanel>
        <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe Fluent Icons" AutomationProperties.Name="关闭提示" Foreground="#9F5662" Click="DismissErrorClick" Padding="8" VerticalAlignment="Top"/>
      </Grid>
    </Border>
    </StackPanel>
    <Grid x:Name="DesktopArea" Grid.Row="2">
      <Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="12,0"/><Style.Triggers>
        <DataTrigger Binding="{Binding Visibility, ElementName=DesktopView}" Value="Visible"><Setter Property="Margin" Value="0"/></DataTrigger>
      </Style.Triggers></Style></Grid.Style>
      <Border Background="White" CornerRadius="18" BorderBrush="#E8EDF3" BorderThickness="1">
        <StackPanel x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
          <Grid Width="98" Height="78" Margin="0,0,0,28">
            <Border Width="70" Height="48" CornerRadius="7" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Border Width="74" Height="50" CornerRadius="7" Background="White" BorderBrush="#6366F1" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
              <Border Height="5" Width="22" Background="#E0E7FF" CornerRadius="2" VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <TextBlock Text="桌面分身" FontSize="27" FontWeight="SemiBold" TextAlignment="Center" Foreground="#0F172A"/>
          <TextBlock Text="一个独立桌面，随时打开。" TextAlignment="Center" Margin="0,12,0,28" Foreground="#94A3B8" FontSize="14"/>
          <Button x:Name="StartButton" Content="启动桌面" Background="#4F46E5" Foreground="White" FontSize="14" Padding="32,13" MinWidth="160" HorizontalAlignment="Center" Click="StartClick"/>
          <Button x:Name="ElevationButton" Content="启用管理员支持" Click="AdminEnableClick" HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Border>
      <wfi:WindowsFormsHost x:Name="DesktopView" Visibility="Collapsed"/>
    </Grid>
  </Grid>
</Window>
